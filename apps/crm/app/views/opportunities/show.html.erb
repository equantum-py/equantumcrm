<% content_for :title, @opportunity.name %>
<p class="text-sm"><%= link_to "← Pipeline", opportunities_path, class: "text-slate-500 hover:text-slate-700" %></p>
<%= render "shared/page_header", title: @opportunity.name, subtitle: "#{@opportunity.company.trade_name} · #{@opportunity.days_in_stage} días en la etapa",
      actions: safe_join([
        stage_badge(@opportunity.pipeline_stage),
        (policy(@opportunity).update? ? link_to("Editar", edit_opportunity_path(@opportunity), class: ApplicationHelper::BUTTON_SECONDARY) : nil)
      ].compact) %>
<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <% if policy(@opportunity).move? %>
      <section class="rounded-lg bg-white p-5 ring-1 ring-slate-200">
        <h2 class="text-sm font-semibold">Cambiar etapa</h2>
        <%= form_with url: move_opportunity_path(@opportunity), method: :patch, class: "mt-3 grid gap-2 sm:grid-cols-[1fr_1fr_auto]" do |f| %>
          <%= f.select :pipeline_stage_id, PipelineStage.ordered.pluck(:name, :id), { selected: @opportunity.pipeline_stage_id }, class: ApplicationHelper::INPUT_CLASS, "aria-label": "Etapa" %>
          <%= f.text_field :lost_reason, placeholder: "Motivo (solo si es Perdido)", class: ApplicationHelper::INPUT_CLASS, "aria-label": "Motivo de pérdida" %>
          <%= f.submit "Mover", class: ApplicationHelper::BUTTON_PRIMARY %>
        <% end %>
      </section>
    <% end %>
    <section class="rounded-lg bg-white p-5 ring-1 ring-slate-200">
      <h2 class="mb-3 text-sm font-semibold">Actividades</h2>
      <%= render "activities/form", subject: @opportunity %>
      <%= render "activities/list", activities: @activities %>
    </section>
  </div>
  <aside class="space-y-6">
    <section class="rounded-lg bg-white p-5 ring-1 ring-slate-200">
      <dl class="space-y-2 text-sm">
        <% [["Empresa", link_to(@opportunity.company.trade_name, @opportunity.company, class: "text-indigo-600 hover:underline")], ["Responsable", @opportunity.owner.name],
            ["País", @opportunity.country&.name], ["Valor estimado", @opportunity.estimated_value&.to_s],
            ["Cierre esperado", @opportunity.expected_close_on && l(@opportunity.expected_close_on, format: :short_es)],
            ["Prospecto de origen", @opportunity.lead && link_to(@opportunity.lead.title, @opportunity.lead, class: "text-indigo-600 hover:underline")],
            ["Motivo de pérdida", @opportunity.lost_reason]].each do |label, value| %>
          <div class="flex justify-between gap-3"><dt class="text-slate-500"><%= label %></dt><dd class="text-right"><%= value.presence || "—" %></dd></div>
        <% end %>
      </dl>
    </section>
    <section class="rounded-lg bg-white p-5 ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold">Servicios y tarifas</h2>
      <% if @rates.any? %>
        <ul class="mt-2 divide-y divide-slate-100 text-sm">
          <% @rates.each do |service, rate| %>
            <li class="py-2">
              <p class="font-medium"><%= service.name %></p>
              <% if rate %>
                <p class="text-xs text-slate-600"><%= rate.min_amount %> – <%= rate.max_amount %> · <%= ApplicationHelper::RATE_UNITS[rate.unit] %></p>
              <% else %>
                <p class="text-xs font-medium text-amber-700">Precio pendiente de aprobación</p>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %><p class="mt-2 text-sm text-slate-500">Sin servicios asignados.</p><% end %>
    </section>
  </aside>
</div>

<div data-controller="records">
<% content_for :title, "Prospectos" %>
<%= render "shared/page_header", title: "Prospectos", subtitle: "De la detección a la próxima oportunidad comercial",
      actions: (policy(Lead).create? ? link_to("Captura rápida", new_lead_path, class: ApplicationHelper::BUTTON_PRIMARY) : nil) %>

<%= form_with url: leads_path, method: :get, class: "mb-4 grid grid-cols-2 gap-2 md:grid-cols-4 xl:grid-cols-7", data: { turbo_action: "advance" } do |f| %>
  <%= f.search_field :q, value: @filters[:q], placeholder: "Buscar…", class: "#{ApplicationHelper::INPUT_CLASS} col-span-2 md:col-span-1", "aria-label": "Buscar prospectos" %>
  <%= render "shared/filter_select", name: :verification, label: "Verificación", options: ApplicationHelper::VERIFICATION.map { |k, (l, _)| [l, k] }, value: @filters[:verification] %>
  <%= render "shared/filter_select", name: :priority, label: "Prioridad comercial", options: CommercialPriority::LABELS.map { |k, label| [label, k] }, value: @filters[:priority] %>
  <%= render "shared/filter_select", name: :priority_status, label: "Confirmación de prioridad", options: [["Confirmada", "confirmed"], ["Estimada", "estimated"]], value: @filters[:priority_status] %>
  <%= render "shared/filter_select", name: :status, label: "Estado: todos", options: ApplicationHelper::LEAD_STATUS.map { |k, (l, _)| [l, k] }, value: @filters[:status] %>
  <%= render "shared/filter_select", name: :band, label: "Intención: todas", options: ApplicationHelper::BANDS.map { |k, (l, _)| [l, k] }, value: @filters[:band] %>
  <%= render "shared/filter_select", name: :country_id, label: "País: todos", options: options_for_countries, value: @filters[:country_id] %>
  <%= render "shared/filter_select", name: :service_id, label: "Servicio: todos", options: options_for_services, value: @filters[:service_id] %>
  <%= render "shared/filter_select", name: :source_id, label: "Fuente: todas", options: options_for_sources, value: @filters[:source_id] %>
  <%= render "shared/filter_select", name: :owner_id, label: "Responsable", options: options_for_users, value: @filters[:owner_id] %>
<% end %>

<div class="arm-list-tools">
  <p role="status" aria-live="polite" aria-atomic="true"><strong data-records-target="count"><%= @leads.size %></strong> registros cargados · máximo 200</p>
  <label>Ordenar registros cargados
    <select data-records-target="sort" data-action="change->records#sort" class="<%= ApplicationHelper::INPUT_CLASS %>">
      <option value="score">Puntuación</option><option value="recent">Más recientes</option><option value="title">Nombre</option>
    </select>
  </label>
</div>
<p class="arm-section-note mb-4">Todos los filtros buscan en la base de datos. El orden local se aplica a los registros cargados.</p>
<% if @leads.any? %>
  <div class="overflow-hidden rounded-lg bg-white ring-1 ring-slate-200">
    <div class="overflow-x-auto">
      <table class="arm-responsive-table arm-leads-table min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-3">Prospecto</th>
            <th class="px-4 py-3">Puntuación</th>
            <th class="px-4 py-3 hidden md:table-cell">Fuente</th>
            <th class="px-4 py-3 hidden md:table-cell">País</th>
            <th class="px-4 py-3 hidden lg:table-cell">Publicado</th>
            <th class="px-4 py-3">Estado</th>
          </tr>
        </thead>
        <tbody data-records-target="body" class="divide-y divide-slate-100">
          <% @leads.each do |lead| %>
            <tr data-records-target="row" data-verification="<%= lead.verification_status %>" data-score="<%= lead.score || -1 %>" data-detected="<%= lead.detected_at.to_i %>" data-title="<%= lead.title %>" class="hover:bg-slate-50">
              <td data-label="Prospecto" class="px-4 py-3 max-w-md">
                <% if @synthetic_lead_ids.include?(lead.id) %><span class="arm-demo">DEMO · registro de prueba</span><% end %>
                <%= link_to lead.title, lead, class: "font-medium text-slate-900 hover:text-indigo-600" %>
                <p class="arm-section-note"><%= lead.country&.name || "País sin confirmar" %> · <%= lead_budget_label(lead) %></p>
                <p class="truncate text-xs text-slate-500"><%= lead.services.map(&:name).join(", ").presence || "Servicio sin definir" %></p>
              </td>
              <td data-label="Puntuación" class="px-4 py-3"><%= score_badge(lead) %><% if lead.commercial_priority %><span class="mt-1 block"><%= priority_badge(lead.commercial_priority, estimated: !@confirmed_priority_ids.include?(lead.id)) %></span><% end %></td>
              <td data-label="Fuente" class="px-4 py-3 hidden md:table-cell"><%= lead.source.name %></td>
              <td data-label="País" class="px-4 py-3 hidden md:table-cell"><%= lead.country&.name || "—" %></td>
              <td data-label="Publicado" class="px-4 py-3 hidden lg:table-cell"><%= lead.published_at ? date_label(lead.published_at) : "Sin fecha verificada" %></td>
              <td data-label="Estado" class="px-4 py-3"><div class="flex flex-wrap gap-1"><%= lead_status_badge(lead.status) %><%= verification_badge(lead.verification_status) %></div></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <%= render "shared/empty_state", title: "No hay prospectos con estos filtros",
        body: "Registrá una publicación con la captura rápida: enlace y extracto alcanzan.",
        action: (policy(Lead).create? ? link_to("Captura rápida", new_lead_path, class: ApplicationHelper::BUTTON_PRIMARY) : nil) %>
<% end %>

</div>

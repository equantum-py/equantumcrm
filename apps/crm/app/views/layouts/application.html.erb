<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
  <head>
    <title><%= [content_for(:title), "eQuantum CRM"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="eQuantum CRM">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full text-slate-900 antialiased" data-controller="sidebar">
    <div data-sidebar-target="backdrop" data-action="click->sidebar#close" class="fixed inset-0 z-30 hidden bg-slate-900/40 lg:hidden"></div>

    <aside data-sidebar-target="panel" class="fixed inset-y-0 left-0 z-40 hidden w-64 flex-col border-r border-slate-200 bg-white lg:flex" aria-label="Navegación principal">
      <div class="flex h-16 items-center gap-2 border-b border-slate-200 px-5">
        <span class="grid size-8 place-items-center rounded-md bg-indigo-600 text-sm font-bold text-white">eQ</span>
        <div class="leading-tight">
          <p class="text-sm font-semibold">eQuantum CRM</p>
          <p class="text-xs text-slate-500">Prospect AI</p>
        </div>
      </div>
      <nav class="flex-1 space-y-1 overflow-y-auto p-3">
        <%= nav_link "Inicio", root_path, icon: :home, active: current_page?(root_path) %>
        <% if policy(Lead).index? %>
          <%= nav_link "Prospectos", leads_path, icon: :spark %>
        <% end %>
        <% if policy(Opportunity).index? %>
          <%= nav_link "Pipeline", opportunities_path, icon: :funnel %>
        <% end %>
        <% if policy(Company).index? %>
          <%= nav_link "Empresas", companies_path, icon: :building %>
        <% end %>
        <% if policy(Activity).index? %>
          <%= nav_link "Actividades", activities_path, icon: :check %>
        <% end %>

        <% if policy(ServiceRate).index? || policy(User).index? || policy(AuditLog).index? %>
          <p class="px-3 pt-5 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Administración</p>
          <% if policy(ServiceRate).index? %><%= nav_link "Tarifas", admin_service_rates_path, icon: :tag %><% end %>
          <% if policy(CommercialThreshold).index? %><%= nav_link "Umbrales", admin_commercial_thresholds_path, icon: :chart %><% end %>
          <% if policy(User).index? %><%= nav_link "Usuarios", admin_users_path, icon: :users %><% end %>
          <% if policy(AuditLog).index? %><%= nav_link "Auditoría", admin_audit_logs_path, icon: :shield %><% end %>
        <% end %>
      </nav>
      <div class="border-t border-slate-200 p-3">
        <div class="flex items-center justify-between gap-2 px-2">
          <div class="min-w-0">
            <p class="truncate text-sm font-medium"><%= current_user.name %></p>
            <p class="truncate text-xs text-slate-500"><%= current_user.role.name %></p>
          </div>
          <%= button_to "Salir", session_path, method: :delete, class: "rounded-md px-2 py-1 text-xs font-medium text-slate-600 hover:bg-slate-100" %>
        </div>
      </div>
    </aside>

    <div class="lg:pl-64">
      <header class="sticky top-0 z-20 flex h-16 items-center gap-3 border-b border-slate-200 bg-white/95 px-4 backdrop-blur sm:px-6">
        <button type="button" data-action="sidebar#open" class="-m-2 p-2 text-slate-600 lg:hidden" aria-label="Abrir menú">
          <%= icon_svg(:menu, "size-6") %>
        </button>
        <%= form_with url: search_path, method: :get, class: "relative flex-1 max-w-xl", role: "search" do |f| %>
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><%= icon_svg(:search, "size-4") %></span>
          <%= f.search_field :q, value: params[:q], placeholder: "Buscar prospectos, empresas, oportunidades…", "aria-label": "Búsqueda global",
                class: "w-full rounded-md border border-slate-200 bg-slate-50 py-2 pr-3 pl-9 text-sm focus:border-indigo-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500/20" %>
        <% end %>
        <% if policy(Lead).create? %>
          <%= link_to new_lead_path, class: ApplicationHelper::BUTTON_PRIMARY do %>
            <%= icon_svg(:plus, "size-4") %><span class="hidden sm:inline">Captura rápida</span>
          <% end %>
        <% end %>
      </header>

      <main class="px-4 py-6 sm:px-6 lg:px-8">
        <% flash.each do |type, message| %>
          <div class="mb-4 rounded-md px-4 py-3 text-sm ring-1 <%= type == 'alert' ? 'bg-red-50 text-red-800 ring-red-200' : 'bg-emerald-50 text-emerald-800 ring-emerald-200' %>" role="status">
            <%= message %>
          </div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>

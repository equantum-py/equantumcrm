<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-50">
  <head>
    <title>Ingresar · eQuantum CRM</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="flex min-h-full items-center justify-center px-4 py-12 text-slate-900 antialiased">
    <div class="w-full max-w-sm">
      <div class="mb-8 flex items-center justify-center gap-2">
        <span class="grid size-10 place-items-center rounded-lg bg-indigo-600 font-bold text-white">eQ</span>
        <span class="text-lg font-semibold">eQuantum CRM</span>
      </div>
      <% flash.each do |type, message| %>
        <div class="mb-4 rounded-md px-4 py-3 text-sm ring-1 <%= type == 'alert' ? 'bg-red-50 text-red-800 ring-red-200' : 'bg-emerald-50 text-emerald-800 ring-emerald-200' %>" role="status"><%= message %></div>
      <% end %>
      <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <%= yield %>
      </div>
    </div>
  </body>
</html>

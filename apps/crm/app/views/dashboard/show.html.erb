<% content_for :title, "Inicio" %>
<%= render "shared/page_header", title: "Captación comercial", subtitle: "Qué atender hoy para conseguir clientes · datos reales de eQuantum ARM" %>

<%= form_with url: root_path, method: :get, class: "mb-6 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6", data: { turbo_action: "advance" } do |f| %>
  <label><span class="sr-only">Desde</span><%= f.date_field :from, value: @metrics.from, class: ApplicationHelper::INPUT_CLASS, onchange: "this.form.requestSubmit()" %></label>
  <label><span class="sr-only">Hasta</span><%= f.date_field :to, value: @metrics.to, class: ApplicationHelper::INPUT_CLASS, onchange: "this.form.requestSubmit()" %></label>
  <%= render "shared/filter_select", name: :country_id, label: "Todos los países", options: options_for_countries, value: @filters[:country_id] %>
  <%= render "shared/filter_select", name: :service_id, label: "Todos los servicios", options: options_for_services, value: @filters[:service_id] %>
  <%= render "shared/filter_select", name: :source_id, label: "Todas las fuentes", options: options_for_sources, value: @filters[:source_id] %>
  <%= render "shared/filter_select", name: :owner_id, label: "Todos los responsables", options: options_for_users, value: @filters[:owner_id] %>
<% end %>

<section aria-labelledby="capture-heading" class="mb-8">
  <h2 id="capture-heading" class="mb-3 text-sm font-semibold">Para atender ahora</h2>
  <% queue = [
    ["Sin verificar", @metrics.to_verify, leads_path(verification: "unverified"), "Prospectos abiertos que nadie confirmó todavía"],
    ["Análisis IA por aprobar", @metrics.pending_ai_reviews, (policy(:agent_control).show? ? agent_control_path : leads_path), "Propuestas de agentes que esperan revisión"],
    ["Prioridad alta sin oportunidad", @metrics.high_priority_without_opportunity, leads_path(priority: "high"), "Listos para convertir en oportunidad"],
    ["Cierran en 7 días", @metrics.closing_soon_count, nil, "Publicaciones que dejan de recibir ofertas"]
  ] %>
  <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    <% queue.each do |label, value, path, hint| %>
      <div class="rounded-lg bg-white p-4 ring-1 <%= value.positive? ? 'ring-indigo-200' : 'ring-slate-200' %>">
        <dt class="text-xs font-medium text-slate-500"><%= label %></dt>
        <dd class="mt-1 text-2xl font-semibold tabular-nums"><%= path ? link_to(value, path, class: "hover:text-indigo-600") : value %></dd>
        <p class="mt-1 text-xs text-slate-500"><%= hint %></p>
      </div>
    <% end %>
  </dl>

  <div class="mt-4 grid gap-4 lg:grid-cols-3">
    <div class="rounded-lg bg-white p-5 ring-1 ring-slate-200 lg:col-span-2">
      <h3 class="text-sm font-semibold">Cierran pronto</h3>
      <% closing = @metrics.closing_soon %>
      <% if closing.any? %>
        <ul class="mt-3 divide-y divide-slate-100 text-sm">
          <% closing.each do |lead| %>
            <li class="flex items-center justify-between gap-3 py-2">
              <%= link_to lead.title, lead_path(lead), class: "min-w-0 truncate font-medium hover:text-indigo-600" %>
              <span class="shrink-0 text-xs text-slate-500 tabular-nums"><%= datetime_label(lead.deadline_at) %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-2 text-sm text-slate-500">Ningún prospecto abierto cierra en los próximos 7 días.</p>
      <% end %>
    </div>
    <div class="rounded-lg bg-white p-5 ring-1 ring-slate-200">
      <h3 class="text-sm font-semibold">Captados por canal</h3>
      <p class="text-xs text-slate-500">En el período filtrado</p>
      <% channels = @metrics.leads_by_channel %>
      <ul class="mt-3 space-y-1 text-sm">
        <% { "manual" => "Captura manual", "api" => "Agentes (API)", "skill" => "Skills de Claude" }.each do |key, label| %>
          <li class="flex justify-between"><span><%= label %></span><span class="font-medium tabular-nums"><%= channels.fetch(key, 0) %></span></li>
        <% end %>
      </ul>
    </div>
  </div>
</section>

<h2 class="mb-3 text-sm font-semibold">Embudo comercial · del <%= l(@metrics.from, format: :short_es) %> al <%= l(@metrics.to, format: :short_es) %></h2>
<% kpis = [
  ["Oportunidades detectadas", @metrics.leads_detected, leads_path],
  ["Prospectos calificados", @metrics.leads_qualified, leads_path(status: "qualified")],
  ["Prioridad alta o muy alta", @metrics.leads_high_priority, leads_path(band: "high")],
  ["Pendientes de contacto", @metrics.pending_contact, opportunities_path],
  ["Conversaciones iniciadas", @metrics.contacted, nil],
  ["Reuniones", @metrics.meetings, nil],
  ["Propuestas enviadas", @metrics.proposals_sent, opportunities_path],
  ["En negociación", @metrics.negotiations, opportunities_path],
  ["Ganados", @metrics.won, nil],
  ["Perdidos", @metrics.lost, nil]
] %>
<dl class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
  <% kpis.each do |label, value, path| %>
    <div class="rounded-lg bg-white p-4 ring-1 ring-slate-200">
      <dt class="text-xs font-medium text-slate-500"><%= label %></dt>
      <dd class="mt-1 text-2xl font-semibold tabular-nums"><%= path ? link_to(value, path, class: "hover:text-indigo-600") : value %></dd>
    </div>
  <% end %>
</dl>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <section class="rounded-lg bg-white p-5 ring-1 ring-slate-200 lg:col-span-2">
    <h2 class="text-sm font-semibold">Pipeline por etapa</h2>
    <% breakdown = @metrics.stage_breakdown; max = [breakdown.map(&:last).max.to_i, 1].max %>
    <ul class="mt-4 space-y-2">
      <% breakdown.each do |stage, count| %>
        <li class="grid grid-cols-[9rem_1fr_2.5rem] items-center gap-3 text-sm">
          <span class="truncate text-slate-600"><%= stage.name %></span>
          <span class="h-2 rounded-full bg-slate-100"><span class="block h-2 rounded-full <%= stage.lost? ? 'bg-red-400' : stage.won? ? 'bg-emerald-500' : 'bg-indigo-500' %>" style="width: <%= (count * 100.0 / max).round %>%"></span></span>
          <span class="text-right tabular-nums font-medium"><%= count %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="space-y-4">
    <div class="rounded-lg bg-white p-5 ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold">Valor del pipeline abierto</h2>
      <% values = @metrics.pipeline_value_by_currency %>
      <% if values.any? %>
        <ul class="mt-2 space-y-1"><% values.each do |amount| %><li class="text-lg font-semibold tabular-nums"><%= amount %></li><% end %></ul>
      <% else %>
        <p class="mt-2 text-sm text-slate-500">Sin oportunidades abiertas con valor estimado.</p>
      <% end %>
      <p class="mt-3 text-xs text-slate-500">Sin conversión entre monedas.</p>
    </div>
    <div class="rounded-lg bg-white p-5 ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold">Conversión comercial</h2>
      <p class="mt-2 text-2xl font-semibold tabular-nums"><%= @metrics.conversion_rate ? "#{@metrics.conversion_rate}%" : "—" %></p>
      <p class="text-xs text-slate-500">Ganadas / (ganadas + perdidas) en el período.</p>
    </div>
    <div class="rounded-lg bg-white p-5 ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold">Actividades vencidas</h2>
      <p class="mt-2 text-2xl font-semibold tabular-nums <%= 'text-red-600' if @metrics.overdue_activities.positive? %>"><%= link_to @metrics.overdue_activities, activities_path %></p>
    </div>
  </section>
</div>

<div class="mt-6 grid gap-6 md:grid-cols-2">
  <% [["Prospectos por fuente", @metrics.leads_by_source], ["Prospectos por país", @metrics.leads_by_country]].each do |title, data| %>
    <section class="rounded-lg bg-white p-5 ring-1 ring-slate-200">
      <h2 class="text-sm font-semibold"><%= title %></h2>
      <% if data.any? %>
        <ul class="mt-3 divide-y divide-slate-100 text-sm">
          <% data.each do |name, count| %><li class="flex justify-between py-2"><span><%= name %></span><span class="tabular-nums font-medium"><%= count %></span></li><% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-slate-500">Sin prospectos en el período.</p>
      <% end %>
    </section>
  <% end %>
</div>

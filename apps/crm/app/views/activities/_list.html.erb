<% if activities.any? %>
  <ul class="divide-y divide-slate-100">
    <% activities.each do |activity| %>
      <li class="flex items-start justify-between gap-3 py-3">
        <div class="min-w-0">
          <p class="text-sm <%= 'text-slate-400 line-through' if activity.completed? %>">
            <span class="font-medium"><%= ApplicationHelper::ACTIVITY_KINDS[activity.kind] %>:</span> <%= activity.title %>
          </p>
          <p class="text-xs <%= activity.overdue? ? 'text-red-600 font-medium' : 'text-slate-500' %>">
            <%= activity.owner.name %>
            <% if activity.due_at %> · vence <%= datetime_label(activity.due_at) %><% end %>
            <% if activity.completed? %> · completada <%= datetime_label(activity.completed_at) %><% end %>
            <% if local_assigns[:show_subject] %> · <%= link_to activity.subject.to_s, activity.subject, class: "text-indigo-600 hover:underline" %><% end %>
          </p>
        </div>
        <% if !activity.completed? && policy(activity).complete? %>
          <%= button_to "Completar", complete_activity_path(activity), method: :patch, class: "shrink-0 rounded-md px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-indigo-200 hover:bg-indigo-50" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="py-3 text-sm text-slate-500"><%= local_assigns[:empty] || "Sin actividades." %></p>
<% end %>

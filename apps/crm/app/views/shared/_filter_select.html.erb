<% blank_label = { "country_id" => "País", "service_id" => "Servicio", "source_id" => "Fuente",
                   "verification" => "Verificación", "priority" => "Prioridad", "priority_status" => "Revisión",
                   "owner_id" => "Asignado a", "status" => "Estado", "band" => "Intención" }.fetch(name.to_s, label) %>
<label class="block">
  <span class="sr-only"><%= label %></span>
  <%= select_tag name, options_for_select(options, value), include_blank: blank_label, class: "#{ApplicationHelper::INPUT_CLASS} min-w-36", data: { controller: "filter", action: "change->filter#submit" } %>
</label>

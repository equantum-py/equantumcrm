<div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
  <div class="min-w-0">
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900"><%= title %></h1>
    <% if local_assigns[:subtitle] %><p class="mt-1 text-sm text-slate-500"><%= subtitle %></p><% end %>
  </div>
  <% if local_assigns[:actions] %><div class="flex flex-wrap gap-2"><%= actions %></div><% end %>
</div>
